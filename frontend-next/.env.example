# Copy this to .env.local and fill in all values.
# Set the same keys in your Vercel project's Environment Variables.

# ── Clerk (https://dashboard.clerk.com -> API Keys) ──────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxx

# ── Supabase server-side (Project Settings -> API -> service_role key) ───────
# Used only in API routes (server). NEVER expose this in the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# ── Upstash Redis — distributed rate limiting (optional but recommended) ─────
# Without these, rate limiting falls back to per-isolate (still works, less strict).
# Create a free Redis database at https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# ── Supabase client-side (Project Settings -> API -> anon/public key) ────────
# Used for BOTH:
#   1. Realtime subscriptions in the browser (contexts/RealtimeContext.tsx).
#      If these are missing, Realtime is silently disabled on all dashboard
#      pages.
#   2. Server-side RLS enforcement (lib/supabase.ts → supaUserRequest()).
#      Every user-facing read AND write route (traces, agents, overview,
#      metrics, billing, integrations, api-keys) uses the anon key as the
#      `apikey` header and the per-user Clerk JWT as the Authorization Bearer
#      token. This is what makes Postgres RLS actually enforce tenant
#      isolation at the DB level. If NEXT_PUBLIC_SUPABASE_ANON_KEY is missing
#      in production, these routes throw RlsEnforcementError (401) — set
#      SUPABASE_RLS_FALLBACK=1 ONLY as a temporary emergency escape hatch
#      (bypasses RLS, NOT recommended for production).
# Safe to expose (it's the anon/public key, not the service-role key).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ── RLS fallback (emergency escape hatch — DO NOT use in production) ────────
# In production (NODE_ENV=production), supaUserRequest FAILS CLOSED when the
# Clerk JWT is unavailable or rejected by Supabase — it throws
# RlsEnforcementError and the route returns 401. This prevents silent
# cross-tenant leaks when the Clerk↔Supabase integration is misconfigured.
#
# Set SUPABASE_RLS_FALLBACK=1 to re-enable the OLD silent-fallback behavior
# (service-role key, RLS bypassed, console.warn logged). This is an explicit
# operator action for emergency debugging or staged rollouts — remove it as
# soon as the Clerk↔Supabase integration is configured.
#
# In development (NODE_ENV !== production), the fallback is always enabled
# so local dev works without the integration configured.
# SUPABASE_RLS_FALLBACK=1
